APP_ENV=development
POSTGRES_DB=vileoruf_crm
POSTGRES_USER=vileoruf_app
POSTGRES_PASSWORD=change_me
POSTGRES_HOST_PORT=55432
DATABASE_URL=postgresql+psycopg://vileoruf_app:change_me@127.0.0.1:55432/vileoruf_crm
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000
JWT_SECRET_KEY=replace-with-a-strong-development-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_COOKIE_SECURE=false
REDIS_HOST_PORT=56379
CELERY_BROKER_URL=redis://127.0.0.1:56379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:56379/1
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_EAGER_PROPAGATES=true
OPENAI_API_KEY=
OPENAI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
AI_RETRY_BACKOFF_SECONDS=2
AI_COMMUNICATION_CONTEXT_CHAR_LIMIT=12000
AI_ANALYSIS_MODEL=gpt-5.4-mini
AI_EMAIL_MODEL=gpt-5.4-mini
AI_MODEL_ALLOWLIST=gpt-5.4-mini,gpt-5.4,gpt-5.4-nano
AI_RATE_LIMIT_REQUESTS=10
AI_RATE_LIMIT_WINDOW_SECONDS=60
